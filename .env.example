# Cloudflare Workers AI：使用有 Workers AI 调用权限的 API Token。
CLOUDFLARE_API_KEY=replace_with_your_cloudflare_api_token
CLOUDFLARE_BASEURL=https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1

# 联网资料检索。
TAVILY_API_KEY=replace_with_your_tavily_api_key

# 使用容器可访问的 PostgreSQL 地址。外部数据库默认启用 SSL。
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# 可选：服务器对外提供服务的端口。
AGENTWRITER_PORT=8000
